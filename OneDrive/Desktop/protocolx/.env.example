# MissIQ Environment Configuration
# Copy this file to .env and adjust variables as needed

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# AI Processing Configuration
# Options: "local" (default deterministic heuristic), "openai", "gemini", "anthropic", "ollama"
AI_PROVIDER=local

# Optional External API Keys (Only required if AI_PROVIDER is not "local")
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OLLAMA_BASE_URL=http://localhost:11434
